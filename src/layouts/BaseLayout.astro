---
import '../styles/global.css'
import '@fontsource/playfair-display/400.css'
import '@fontsource/playfair-display/400-italic.css'
import '@fontsource/playfair-display/600.css'
import '@fontsource/playfair-display/600-italic.css'
import '@fontsource/playfair-display/700.css'
import '@fontsource/nunito/300.css'
import '@fontsource/nunito/400.css'
import '@fontsource/nunito/500.css'
import '@fontsource/nunito/600.css'
import '@fontsource/nunito/700.css'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import CookieBanner from '../components/CookieBanner.astro'
import SEO from '../components/SEO.astro'
import type { Lang } from '../i18n/index'

interface Props {
  lang: Lang
  title?: string
  description?: string
  ogImage?: string
  canonical?: string
  gscVerification?: string
}

const {
  lang,
  title = lang === 'ca' ? 'Logopeda a València' : 'Logopeda en Valencia',
  description = lang === 'ca'
    ? "Logopèdia neonatal, reeducació de les funcions orals i desenvolupament del llenguatge a València. Àngela Alonso, logopeda a domicili, presencial i online."
    : "Logopedia neonatal, reeducación de las funciones orales y desarrollo del lenguaje en Valencia. Àngela Alonso, logopeda a domicilio, presencial y online.",
  ogImage,
  canonical,
  gscVerification,
} = Astro.props
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <SEO
      title={title}
      description={description}
      lang={lang}
      ogImage={ogImage}
      canonical={canonical}
      gscVerification={gscVerification}
    />
    <!-- Google Analytics 4 — Consent Mode v2 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-T992PQQVQT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { analytics_storage: 'denied', wait_for_update: 500 });
      if (localStorage.getItem('cookies_accepted') === 'all') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
      gtag('js', new Date());
      gtag('config', 'G-T992PQQVQT');
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CookieBanner />
    <WhatsAppButton lang={lang} />
  </body>
</html>
