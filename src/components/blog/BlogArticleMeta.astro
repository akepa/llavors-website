---
interface Props {
  author: string
  date: string
  readingTime: number
  readingTimeLabel: string
}

const { author, date, readingTime, readingTimeLabel } = Astro.props
---

<div class="article-meta">
  <span class="article-meta-author">{author}</span>
  <span class="article-meta-sep" aria-hidden="true">·</span>
  <time class="article-meta-date">{date}</time>
  <span class="article-meta-sep" aria-hidden="true">·</span>
  <span class="article-meta-time">{readingTime} {readingTimeLabel}</span>
</div>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 0.88rem;
    color: var(--text-soft);
    margin-top: 18px;
  }
  .article-meta-author { font-weight: 600; color: var(--text); }
  .article-meta-sep { color: var(--pink-light); }
</style>
