---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BlogArticleMeta from './BlogArticleMeta.astro'

interface Props {
  title: string
  categoryLabel: string
  author: string
  date: string
  dateISO: string
  readingTime: number
  readingTimeLabel: string
  updatedDate?: string
  updatedDateISO?: string
  updatedLabel?: string
  heroImage?: ImageMetadata
  heroImageAlt?: string
}

const { title, categoryLabel, author, date, dateISO, readingTime, readingTimeLabel, updatedDate, updatedDateISO, updatedLabel, heroImage, heroImageAlt } = Astro.props
---

<header class="article-header">
  <div class="container article-header-content">
    <span class="section-label">{categoryLabel}</span>
    <h1 class="article-h1">{title}</h1>
    <BlogArticleMeta
      author={author}
      date={date}
      dateISO={dateISO}
      readingTime={readingTime}
      readingTimeLabel={readingTimeLabel}
      updatedDate={updatedDate}
      updatedDateISO={updatedDateISO}
      updatedLabel={updatedLabel}
    />
  </div>
  <div class="article-hero">
    {heroImage ? (
      <Image
        src={heroImage}
        alt={heroImageAlt ?? title}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="article-hero-img"
      />
    ) : (
      <div class="article-hero-inner" role="img" aria-label={title}></div>
    )}
  </div>
</header>

<style>
  .article-header {
    padding-top: 52px;
    border-bottom: 1px solid var(--pink-light);
  }
  .article-header-content {
    padding-bottom: 40px;
    max-width: 800px;
  }
  .article-h1 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    margin-top: 12px;
    line-height: 1.2;
    color: var(--text);
  }
  .article-hero {
    width: 100%;
    aspect-ratio: 21 / 8;
    overflow: hidden;
  }
  .article-hero-inner {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--pink-pale) 0%, var(--bg-dark) 55%, #e8ddd4 100%);
  }
  .article-hero :global(.article-hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .article-hero { aspect-ratio: 4 / 3; }
    .article-header { padding-top: 32px; }
  }
</style>
