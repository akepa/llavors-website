---
// No props — reads lang from <html lang="..."> at runtime
---

<div id="cookie-banner" class="cookie-banner" style="display:none">
  <p id="cookie-text"></p>
  <div class="cookie-btns">
    <button id="cookie-btn-essential" type="button"></button>
    <button id="cookie-btn-all" type="button"></button>
  </div>
</div>

<script>
  const banner   = document.getElementById('cookie-banner')!
  const textEl   = document.getElementById('cookie-text')!
  const btnEss   = document.getElementById('cookie-btn-essential')!
  const btnAll   = document.getElementById('cookie-btn-all')!

  const stored = localStorage.getItem('cookies_accepted')
  // 'true' is the legacy value from before Slice 6 — treat as essential
  if (!stored || stored === 'true') {
    const isVal = document.documentElement.lang === 'ca'
    const base  = import.meta.env.BASE_URL

    textEl.innerHTML = isVal
      ? `Aquest lloc utilitza cookies tècniques (necessàries) i, si ho acceptes, cookies analítiques de Google Analytics per millorar el servei. <a href="${base}cookies" rel="noopener noreferrer">Política de cookies</a>`
      : `Este sitio utiliza cookies técnicas (necesarias) y, si lo aceptas, cookies analíticas de Google Analytics para mejorar el servicio. <a href="${base}es/cookies" rel="noopener noreferrer">Política de cookies</a>`

    btnEss.textContent = isVal ? 'Només tècniques' : 'Solo técnicas'
    btnAll.textContent = isVal ? 'Acceptar totes'  : 'Aceptar todas'
    banner.style.display = 'flex'
  }

  btnEss.addEventListener('click', () => {
    localStorage.setItem('cookies_accepted', 'essential')
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', { analytics_storage: 'denied' })
    }
    banner.style.display = 'none'
  })

  btnAll.addEventListener('click', () => {
    localStorage.setItem('cookies_accepted', 'all')
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', { analytics_storage: 'granted' })
    }
    banner.style.display = 'none'
  })
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 150;
    background: var(--text);
    color: var(--bg);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    padding: 16px 20px;
    max-width: 520px;
    width: calc(100% - 32px);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    line-height: 1.5;
    animation: cb-fade-in 0.3s ease both;
  }
  .cookie-banner p {
    flex: 1;
    min-width: 200px;
    margin: 0;
    opacity: 0.85;
  }
  .cookie-banner a {
    color: var(--pink-light);
    text-decoration: underline;
  }
  .cookie-btns {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .cookie-btns button {
    background: transparent;
    color: var(--bg);
    border: 1.5px solid rgba(255,255,255,0.35);
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 0.82rem;
    font-weight: 700;
    font-family: 'Nunito', sans-serif;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  #cookie-btn-all {
    background: var(--pink);
    border-color: var(--pink);
  }
  .cookie-btns button:hover { opacity: 0.88; }
  @keyframes cb-fade-in {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
</style>
