---
// No props — reads lang from <html lang="..."> at runtime
---

<div id="cookie-banner" class="cookie-banner" style="display:none">
  <p id="cookie-text"></p>
  <div class="cookie-buttons">
    <button id="cookie-btn-essential" type="button" class="btn-essential"></button>
    <button id="cookie-btn-all" type="button" class="btn-all"></button>
  </div>
</div>

<script is:inline>
  const banner   = document.getElementById('cookie-banner')
  const textEl   = document.getElementById('cookie-text')
  const btnAll   = document.getElementById('cookie-btn-all')
  const btnEss   = document.getElementById('cookie-btn-essential')

  if (!localStorage.getItem('cookies_consent')) {
    const isVal = document.documentElement.lang === 'ca'
    const base  = import.meta.env.BASE_URL

    textEl.innerHTML = isVal
      ? `Este lloc web utilitza cookies tècniques pròpies i, si ho acceptes, cookies analítiques (Google Analytics) per millorar el servei. <a href="${base}cookies" rel="noopener noreferrer">Política de cookies</a>`
      : `Este sitio web utiliza cookies técnicas propias y, si lo aceptas, cookies analíticas (Google Analytics) para mejorar el servicio. <a href="${base}cookies" rel="noopener noreferrer">Política de cookies</a>`

    btnAll.textContent = isVal ? 'Acceptar totes' : 'Aceptar todas'
    btnEss.textContent = isVal ? 'Només tècniques' : 'Solo técnicas'
    banner.style.display = 'flex'
  }

  btnAll.addEventListener('click', () => {
    localStorage.setItem('cookies_consent', 'all')
    if (typeof gtag !== 'undefined') {
      gtag('consent', 'update', { analytics_storage: 'granted' })
    }
    banner.style.display = 'none'
  })

  btnEss.addEventListener('click', () => {
    localStorage.setItem('cookies_consent', 'essential')
    banner.style.display = 'none'
  })
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 150;
    background: var(--text);
    color: var(--bg);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    padding: 16px 20px;
    max-width: 520px;
    width: calc(100% - 32px);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    line-height: 1.5;
    animation: cb-fade-in 0.3s ease both;
  }
  .cookie-banner p {
    flex: 1;
    min-width: 200px;
    margin: 0;
    opacity: 0.85;
  }
  .cookie-banner a {
    color: var(--pink-light);
    text-decoration: underline;
  }
  .cookie-buttons {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .cookie-buttons button {
    border: none;
    border-radius: 8px;
    padding: 9px 16px;
    font-size: 0.82rem;
    font-weight: 700;
    font-family: 'Nunito', sans-serif;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .btn-all {
    background: var(--pink);
    color: #fff;
  }
  .btn-essential {
    background: rgba(255,255,255,0.15);
    color: var(--bg);
  }
  .cookie-buttons button:hover { opacity: 0.85; }
  @keyframes cb-fade-in {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
</style>
