---
import type { Translations } from '../i18n/index'
import type { Lang } from '../i18n/index'

interface Props {
  t: Translations
  lang: Lang
}

const { t, lang } = Astro.props
const apiUrl = import.meta.env.PUBLIC_BOOKING_API_URL ?? ''
---

<section class="booking section" id="reserva">
  <div class="container">

    <div class="section-title" style="text-align:center">
      <span class="section-label">{t.res_label}</span>
      <h2>{t.res_h2}</h2>
      <p style="margin: 0 auto">{t.res_sub}</p>
    </div>

    <div class="booking-options">
      <div class="booking-option">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>{t.res_o1}</span>
      </div>
      <div class="booking-option">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>{t.res_o2}</span>
      </div>
      <div class="booking-option">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <span>{t.res_o3}</span>
      </div>
    </div>

    {apiUrl ? (
      <div
        id="booking-widget"
        data-api-url={apiUrl}
        data-lang={lang}
        data-i18n={JSON.stringify({
          selectDay:   t.book_select_day,
          available:   t.book_available,
          loading:     t.book_loading,
          noSlots:     t.book_no_slots,
          name:        t.book_name,
          namePh:      t.book_name_ph,
          email:       t.book_email,
          emailPh:     t.book_email_ph,
          phone:       t.book_phone,
          phonePh:     t.book_phone_ph,
          notes:       t.book_notes,
          notesPh:     t.book_notes_ph,
          privacy:     t.book_privacy,
          privacyLink: t.book_privacy_link,
          back:        t.book_back,
          confirm:     t.book_confirm,
          confirming:   t.book_confirming,
          emailInvalid: t.book_email_invalid,
          successTitle:t.book_success_title,
          successText: t.book_success_text,
          error:       t.book_error,
          slotTaken:   t.book_slot_taken,
          nameRequired:    t.book_name_required,
          emailRequired:   t.book_email_required,
          notesRequired:   t.book_notes_required,
          privacyRequired: t.book_privacy_required,
        })}
      >
        <div class="calendar-pane">
          <div class="calendar-header">
            <button id="prev-month" aria-label="Mes anterior" type="button">&#8592;</button>
            <span class="month-wrap">
              <span id="month-label"></span>
              <span id="cal-loading" class="cal-loading hidden" aria-label="Carregant disponibilitat"></span>
            </span>
            <button id="next-month" aria-label="Mes següent" type="button">&#8594;</button>
          </div>
          <div class="calendar-grid">
            <div class="weekday">L</div>
            <div class="weekday">M</div>
            <div class="weekday">X</div>
            <div class="weekday">J</div>
            <div class="weekday">V</div>
            <div class="weekday">S</div>
            <div class="weekday">D</div>
            <div id="calendar-days"></div>
          </div>
        </div>

        <div class="slots-pane">
          <div id="slots-placeholder" class="slots-placeholder">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <p id="slots-placeholder-text"></p>
          </div>
          <div id="slots-list" class="slots-list hidden"></div>
          <div id="booking-form-wrap" class="booking-form-wrap hidden">
            <div id="booking-selected-time" class="booking-selected-time"></div>
            <form id="booking-form" novalidate>
              <div class="form-group">
                <label for="book-name" id="label-name"></label>
                <input id="book-name" name="name" type="text" autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="book-email" id="label-email"></label>
                <input id="book-email" name="email" type="email" autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="book-phone" id="label-phone"></label>
                <input id="book-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label for="book-notes" id="label-notes"></label>
                <textarea id="book-notes" name="notes" rows="3"></textarea>
              </div>
              <div class="form-check">
                <input id="book-privacy" name="privacy" type="checkbox" />
                <label for="book-privacy">
                  <span id="privacy-text"></span>
                  <a href={`${import.meta.env.BASE_URL}privacidad`} id="privacy-link" target="_blank" rel="noopener noreferrer"></a>
                </label>
              </div>
              <div id="form-error" class="form-error hidden"></div>
              <div class="form-actions">
                <button type="button" id="btn-back" class="btn-back"></button>
                <button type="submit" id="btn-confirm" class="btn btn-primary"></button>
              </div>
            </form>
          </div>
          <div id="booking-success" class="booking-success hidden">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <h3 id="success-title"></h3>
            <p id="success-text"></p>
          </div>
        </div>
      </div>
    ) : (
      <div class="calendly-wrap">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <strong>{t.cal_title}</strong>
        <p>{t.cal_text}</p>
        <a href="https://wa.me/34614337743" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {t.cal_btn}
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .booking { background: var(--bg); text-align: center; }

  .booking-options {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 16px; margin-bottom: 40px;
  }
  .booking-option {
    display: flex; align-items: center; gap: 8px;
    background: var(--bg-card); border-radius: 50px;
    padding: 10px 20px; font-size: 0.9rem; font-weight: 600;
    color: var(--gray); border: 1px solid var(--bg-dark);
  }
  .booking-option svg {
    width: 18px; height: 18px;
    stroke: var(--pink); fill: none; stroke-width: 2;
  }

  /* Fallback (sin API URL) */
  .calendly-wrap {
    max-width: 700px; margin: 0 auto;
    background: var(--white); border-radius: 24px;
    border: 1.5px solid var(--pink-light); min-height: 300px;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 16px; padding: 48px;
    color: var(--text-soft);
  }
  .calendly-wrap svg {
    width: 52px; height: 52px;
    stroke: var(--pink-light); fill: none; stroke-width: 1.5;
  }
  .calendly-wrap strong {
    display: block; font-size: 1.1rem;
    color: var(--text); font-family: 'Playfair Display', serif;
  }
  .calendly-wrap p { font-size: 0.9rem; max-width: 320px; text-align: center; }

  /* Widget principal */
  #booking-widget {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: var(--white);
    border-radius: 24px;
    border: 1.5px solid var(--bg-dark);
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
  }

  /* Calendario */
  .calendar-pane {
    padding: 28px;
    border-right: 1px solid var(--bg-dark);
  }
  .calendar-header {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 20px; font-weight: 700; font-size: 1rem;
  }
  .calendar-header button {
    background: none; border: 1px solid var(--bg-dark);
    border-radius: 8px; width: 32px; height: 32px;
    cursor: pointer; font-size: 1rem; display: flex;
    align-items: center; justify-content: center;
    color: var(--text); transition: background 0.15s;
  }
  .calendar-header button:hover { background: var(--bg); }
  .month-wrap { flex: 1; display: flex; align-items: center; gap: 6px; }

  @keyframes cal-blink {
    0%, 80%, 100% { opacity: 0.15; }
    40%           { opacity: 1; }
  }
  .cal-loading {
    display: inline-block; width: 5px; height: 5px;
    border-radius: 50%; background: var(--pink);
    box-shadow: 8px 0 0 var(--pink), 16px 0 0 var(--pink);
    animation: cal-blink 1.2s infinite ease-in-out;
    margin-left: 4px; flex-shrink: 0;
  }

  .calendar-grid {
    display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;
  }
  .weekday {
    text-align: center; font-size: 0.75rem;
    font-weight: 600; color: var(--gray);
    padding: 6px 0;
  }
  #calendar-days {
    display: contents;
  }
  :global(.cal-day) {
    aspect-ratio: 1; display: flex; align-items: center;
    justify-content: center; border-radius: 10px;
    font-size: 0.9rem; cursor: default;
    transition: background 0.15s;
  }
  :global(.cal-day.available) {
    background: var(--pink-light);
    color: var(--pink);
    font-weight: 600; cursor: pointer;
  }
  :global(.cal-day.available:hover) { background: var(--pink); color: var(--white); }
  :global(.cal-day.selected) { background: var(--pink) !important; color: var(--white) !important; }
  :global(.cal-day.disabled) { color: var(--gray); opacity: 0.4; }
  :global(.cal-day.empty) { }

  /* Panel derecho */
  .slots-pane {
    padding: 28px;
    display: flex; flex-direction: column;
  }

  .slots-placeholder {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px; color: var(--text-soft);
  }
  .slots-placeholder svg {
    width: 40px; height: 40px;
    stroke: var(--pink-light); fill: none; stroke-width: 1.5;
  }
  .slots-placeholder p { font-size: 0.9rem; text-align: center; max-width: 200px; }

  :global(.slots-header) { font-weight: 700; margin-bottom: 4px; }
  :global(.slots-date) { font-size: 0.85rem; color: var(--gray); margin-bottom: 16px; }
  :global(.slots-scroll) { overflow-y: auto; max-height: 320px; display: flex; flex-direction: column; gap: 8px; }
  :global(.slot-btn) {
    width: 100%; padding: 12px; border: 1.5px solid var(--bg-dark);
    border-radius: 12px; background: var(--white); cursor: pointer;
    font-size: 0.95rem; font-weight: 500; color: var(--text);
    transition: all 0.15s; text-align: center;
  }
  :global(.slot-btn:hover) {
    border-color: var(--pink);
    color: var(--pink);
  }

  /* Formulario */
  .booking-selected-time {
    border-left: 3px solid var(--pink);
    padding-left: 12px; margin-bottom: 16px;
    font-weight: 600; font-size: 0.95rem;
  }
  .form-group { margin-bottom: 12px; text-align: left; }
  .form-group label {
    display: block; font-size: 0.9rem;
    font-weight: 600; margin-bottom: 4px;
    color: var(--text);
  }
  .form-group input, .form-group textarea {
    width: 100%; padding: 10px 12px; border: 1.5px solid var(--bg-dark);
    border-radius: 10px; font-size: 0.95rem; font-family: inherit;
    background: var(--bg); color: var(--text);
    transition: border-color 0.15s; box-sizing: border-box;
  }
  .form-group textarea { resize: none; display: block; width: 100%; }
  .form-group input:focus, .form-group textarea:focus {
    outline: none; border-color: var(--pink);
  }
  .form-check {
    display: flex; align-items: flex-start; gap: 8px;
    margin-bottom: 12px; font-size: 0.9rem;
  }
  .form-check input { margin-top: 3px; flex-shrink: 0; }
  .form-check a { color: var(--pink); }
  .form-error {
    background: #fef2f2; color: #dc2626;
    border-radius: 8px; padding: 8px 12px;
    font-size: 0.85rem; margin-bottom: 10px;
  }
  .form-actions { display: flex; gap: 8px; margin-top: 4px; }
  .btn-back {
    background: none; border: 1.5px solid var(--bg-dark);
    border-radius: 12px; padding: 12px 16px; cursor: pointer;
    font-size: 0.85rem; color: var(--gray);
    transition: all 0.15s; white-space: nowrap;
  }
  .btn-back:hover { border-color: var(--text); color: var(--text); }
  #btn-confirm { flex: 1; }

  /* Éxito */
  .booking-success {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px; text-align: center;
  }
  .booking-success svg {
    width: 48px; height: 48px;
    stroke: var(--pink); stroke-width: 2.5;
    fill: none;
  }
  .booking-success h3 { color: var(--pink); font-size: 1.1rem; }
  .booking-success p { font-size: 0.9rem; color: var(--text-soft); }

  .hidden { display: none !important; }

  @media (max-width: 700px) {
    #booking-widget { grid-template-columns: 1fr; }
    .calendar-pane {
      border-right: none;
      border-bottom: 1px solid var(--bg-dark);
      padding: 20px 16px;
    }
    .slots-pane { padding: 20px 16px; }
    .booking-options { flex-direction: column; align-items: stretch; }
    .booking-option { justify-content: center; }
    .form-actions { flex-direction: column; }
  }
</style>

<script>
  interface I18n {
    selectDay: string; available: string; loading: string; noSlots: string
    name: string; namePh: string; email: string; emailPh: string
    phone: string; phonePh: string; notes: string; notesPh: string
    privacy: string; privacyLink: string; back: string; confirm: string; confirming: string
    successTitle: string; successText: string; error: string; slotTaken: string
    nameRequired: string; emailRequired: string; emailInvalid: string; notesRequired: string; privacyRequired: string
  }

  const widget = document.getElementById('booking-widget') as HTMLElement | null
  if (!widget) throw new Error('booking-widget not found')

  const API_URL  = widget.dataset.apiUrl!
  const LANG     = widget.dataset.lang as 'ca' | 'es'
  const i18n     = JSON.parse(widget.dataset.i18n!) as I18n
  if (LANG !== 'ca' && LANG !== 'es') throw new Error('booking-widget: invalid lang')

  // State
  let currentYear  = new Date().getFullYear()
  let currentMonth = new Date().getMonth() + 1 // 1-based
  let errorField: string | null = null
  let availableDays: string[] = []
  let slotsCache: Record<string, string[]> = {}
  const monthCache: Record<string, { availableDays: string[], slots: Record<string, string[]> }> = {}
  let selectedDate  = ''
  let selectedTime  = ''

  // DOM refs
  const monthLabel      = document.getElementById('month-label')!
  const calDays         = document.getElementById('calendar-days')!
  const prevBtn         = document.getElementById('prev-month')!
  const nextBtn         = document.getElementById('next-month')!
  const slotsPlaceholder= document.getElementById('slots-placeholder')!
  const slotsList       = document.getElementById('slots-list')!
  const formWrap        = document.getElementById('booking-form-wrap')!
  const successWrap     = document.getElementById('booking-success')!
  const placeholderText = document.getElementById('slots-placeholder-text')!
  const calLoadingEl    = document.getElementById('cal-loading')!

  const MONTH_NAMES_CA = ['Gener','Febrer','Març','Abril','Maig','Juny','Juliol','Agost','Setembre','Octubre','Novembre','Desembre']
  const MONTH_NAMES_ES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']
  const DAY_NAMES_CA   = ['Diumenge','Dilluns','Dimarts','Dimecres','Dijous','Divendres','Dissabte']
  const DAY_NAMES_ES   = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado']

  function monthName(year: number, month: number) {
    const names = LANG === 'ca' ? MONTH_NAMES_CA : MONTH_NAMES_ES
    return names[month - 1] + ' ' + year
  }

  function toDateStr(y: number, m: number, d: number) {
    return y + '-' + String(m).padStart(2,'0') + '-' + String(d).padStart(2,'0')
  }

  async function loadMonth(year: number, month: number) {
    monthLabel.textContent = monthName(year, month)

    const cacheKey = `${year}-${month}`
    const cached = monthCache[cacheKey]
    if (cached) {
      availableDays = cached.availableDays
      slotsCache    = cached.slots
      renderCalendar(year, month)
      return
    }

    availableDays = []
    slotsCache = {}
    renderCalendar(year, month)
    show(calLoadingEl)
    try {
      const res = await fetch(`${API_URL}?action=days&year=${year}&month=${month}`)
      const data = await res.json()
      if (data.error) return
      const entry = { availableDays: data.availableDays ?? [], slots: data.slots ?? {} }
      monthCache[cacheKey] = entry  // always cache, regardless of current view
      if (year === currentYear && month === currentMonth) {
        availableDays = entry.availableDays
        slotsCache    = entry.slots
        renderCalendar(year, month)
      }
    } catch { /* silently ignore — calendar stays with no available days */ }
    finally { hide(calLoadingEl) }
  }

  function renderCalendarLoading() {
    let html = ''
    for (let i = 0; i < 35; i++) html += '<div class="cal-day disabled" style="opacity:0.3"></div>'
    calDays.innerHTML = html
  }

  function renderCalendar(year: number, month: number) {
    const today    = new Date(); today.setHours(0,0,0,0)
    const firstDay = new Date(year, month - 1, 1).getDay() // 0=Sun
    const offset   = (firstDay + 6) % 7  // shift so Monday=0
    const daysInMonth = new Date(year, month, 0).getDate()

    let html = ''
    for (let i = 0; i < offset; i++) html += '<div class="cal-day empty"></div>'

    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr = toDateStr(year, month, d)
      const date    = new Date(year, month - 1, d)
      const isPast  = date < today
      const isAvail = availableDays.includes(dateStr)
      const isSel   = dateStr === selectedDate

      let cls = 'cal-day'
      if (isPast)       cls += ' disabled'
      else if (isAvail) cls += ' available' + (isSel ? ' selected' : '')
      else              cls += ' disabled'

      html += `<div class="${cls}" data-date="${dateStr}">${d}</div>`
    }

    calDays.innerHTML = html
  }

  async function selectDay(date: string) {
    selectedDate = date
    selectedTime = ''
    renderCalendar(currentYear, currentMonth)

    if (slotsCache[date] !== undefined) {
      hide(slotsPlaceholder); hide(formWrap); hide(successWrap)
      show(slotsList)
      renderSlots(date, slotsCache[date])
      return
    }

    // Fallback: fetch individually (e.g. cache miss after month reload race)
    showSlotsLoading()
    try {
      const res = await fetch(`${API_URL}?action=slots&date=${date}`)
      const data = await res.json()
      if (data.error) { renderSlots(date, []); return }
      renderSlots(date, data.slots ?? [])
    } catch {
      renderSlots(date, [])
    }
  }

  function showSlotsLoading() {
    hide(slotsPlaceholder); hide(formWrap); hide(successWrap)
    slotsList.innerHTML = `<p class="slots-header">${i18n.available}</p><p style="font-size:0.9rem;color:var(--gray)">${i18n.loading}</p>`
    show(slotsList)
  }

  function renderSlots(date: string, slots: string[]) {
    const parts = date.split('-').map(Number)
    const d     = new Date(parts[0], parts[1] - 1, parts[2])
    const dayNames   = LANG === 'ca' ? DAY_NAMES_CA   : DAY_NAMES_ES
    const monthNames = LANG === 'ca' ? MONTH_NAMES_CA : MONTH_NAMES_ES
    const dateLabel  = dayNames[d.getDay()] + ', ' + parts[2] + ' de ' + monthNames[parts[1]-1]

    const cutoff = new Date(Date.now() + 24 * 60 * 60 * 1000)
    slots = slots.filter(t => {
      const [h, m] = t.split(':').map(Number)
      return new Date(parts[0], parts[1]-1, parts[2], h, m) >= cutoff
    })

    if (slots.length === 0) {
      // Day had slots in the API but all are within 24h — remove it from the calendar
      availableDays = availableDays.filter(d => d !== date)
      selectedDate = ''
      renderCalendar(currentYear, currentMonth)
      hide(slotsList)
      show(slotsPlaceholder)
      return
    }

    const endTimes = slots.map((t: string) => addMinutes(t, 30))

    slotsList.innerHTML =
      `<p class="slots-header">${i18n.available}</p>` +
      `<p class="slots-date">${dateLabel} · hora peninsular (Madrid)</p>` +
      `<div class="slots-scroll">` +
      slots.map((s: string, i: number) =>
        `<button class="slot-btn" data-time="${s}" type="button">${s}–${endTimes[i]}</button>`
      ).join('') +
      `</div>`
  }

  function selectSlot(date: string, time: string) {
    selectedTime = time
    showBookingForm(date, time)
  }

  function show(el: HTMLElement) { el.classList.remove('hidden') }
  function hide(el: HTMLElement) { el.classList.add('hidden') }

  function addMinutes(timeStr: string, mins: number): string {
    const [h, m] = timeStr.split(':').map(Number)
    const total = h * 60 + m + mins
    return String(Math.floor(total / 60) % 24).padStart(2,'0') + ':' + String(total % 60).padStart(2,'0')
  }

  // Placeholder text
  placeholderText.textContent = i18n.selectDay

  // Delegated listener — calendar days
  calDays.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('.cal-day.available')
    if (!el) return
    const date = (el as HTMLElement).dataset.date!
    selectDay(date)
  })

  // Delegated listener — slot buttons
  slotsList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.slot-btn')
    if (!btn) return
    const time = (btn as HTMLElement).dataset.time!
    selectSlot(selectedDate, time)
  })

  function clearSelection() {
    selectedDate = ''
    selectedTime = ''
    hide(slotsList); hide(formWrap); hide(successWrap)
    show(slotsPlaceholder)
  }

  // Month navigation
  prevBtn.addEventListener('click', () => {
    const now = new Date()
    if (currentYear === now.getFullYear() && currentMonth === now.getMonth() + 1) return
    currentMonth--
    if (currentMonth < 1) { currentMonth = 12; currentYear-- }
    clearSelection()
    loadMonth(currentYear, currentMonth)
  })

  nextBtn.addEventListener('click', () => {
    currentMonth++
    if (currentMonth > 12) { currentMonth = 1; currentYear++ }
    clearSelection()
    loadMonth(currentYear, currentMonth)
  })

  // Back button
  document.getElementById('btn-back')!.addEventListener('click', () => {
    hide(formWrap)
    selectDay(selectedDate)
  })

  // Form submit
  document.getElementById('booking-form')!.addEventListener('submit', async (e) => {
    e.preventDefault()
    const form      = e.target as HTMLFormElement
    const name      = (form.querySelector('#book-name') as HTMLInputElement).value.trim()
    const email     = (form.querySelector('#book-email') as HTMLInputElement).value.trim()
    const phone     = (form.querySelector('#book-phone') as HTMLInputElement).value.trim()
    const notes     = (form.querySelector('#book-notes') as HTMLTextAreaElement).value.trim()
    const privacy   = (form.querySelector('#book-privacy') as HTMLInputElement).checked
    const errorEl   = document.getElementById('form-error')!
    const btnConfirm = document.getElementById('btn-confirm') as HTMLButtonElement

    errorEl.classList.add('hidden')
    errorField = null
    if (!selectedDate || !selectedTime) return

    const nameEl  = form.querySelector('#book-name')  as HTMLInputElement
    const emailEl = form.querySelector('#book-email') as HTMLInputElement
    const notesEl = form.querySelector('#book-notes') as HTMLTextAreaElement

    const showFieldError = (msg: string, fieldId: string, focusEl?: HTMLElement) => {
      errorField = fieldId
      errorEl.textContent = msg
      errorEl.classList.remove('hidden')
      focusEl?.focus()
    }

    if (!name)    { showFieldError(i18n.nameRequired,    'book-name',    nameEl);  return }
    if (!email)   { showFieldError(i18n.emailRequired,   'book-email',   emailEl); return }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showFieldError(i18n.emailInvalid, 'book-email', emailEl); return }
    if (!notes)   { showFieldError(i18n.notesRequired,   'book-notes',   notesEl); return }
    if (!privacy) { showFieldError(i18n.privacyRequired, 'book-privacy');           return }

    btnConfirm.disabled = true
    btnConfirm.textContent = i18n.confirming

    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({ date: selectedDate, time: selectedTime, name, email, phone, notes, lang: LANG })
      })
      const data = await res.json()

      if (data.ok) {
        hide(formWrap)
        const successText = document.getElementById('success-text')!
        successText.textContent = i18n.successText + ' ' + email
        document.getElementById('success-title')!.textContent = i18n.successTitle
        show(successWrap)
      } else {
        const msg = data.error === 'slot_taken' ? i18n.slotTaken : i18n.error
        errorEl.textContent = msg
        errorEl.classList.remove('hidden')
        btnConfirm.disabled = false
        btnConfirm.textContent = i18n.confirm
      }
    } catch {
      errorEl.textContent = i18n.error
      errorEl.classList.remove('hidden')
      btnConfirm.disabled = false
      btnConfirm.textContent = i18n.confirm
    }
  })

  function showBookingForm(date: string, time: string) {
    errorField = null
    hide(slotsPlaceholder); hide(slotsList); hide(successWrap)
    show(formWrap)

    const parts = date.split('-').map(Number)
    const endStr = addMinutes(time, 30)
    const dayNames = LANG === 'ca' ? DAY_NAMES_CA : DAY_NAMES_ES
    const monthNames = LANG === 'ca' ? MONTH_NAMES_CA : MONTH_NAMES_ES
    const d = new Date(parts[0], parts[1]-1, parts[2])
    document.getElementById('booking-selected-time')!.textContent =
      dayNames[d.getDay()] + ', ' + parts[2] + ' de ' + monthNames[parts[1]-1] + ' de ' + parts[0] + ' · ' + time + '–' + endStr

    const labelName  = document.getElementById('label-name')!
    const labelEmail = document.getElementById('label-email')!
    const labelPhone = document.getElementById('label-phone')!
    const labelNotes = document.getElementById('label-notes')!
    const nameInput  = document.getElementById('book-name') as HTMLInputElement
    const emailInput = document.getElementById('book-email') as HTMLInputElement
    const phoneInput = document.getElementById('book-phone') as HTMLInputElement
    const notesInput = document.getElementById('book-notes') as HTMLTextAreaElement
    const privText   = document.getElementById('privacy-text')!
    const privLink   = document.getElementById('privacy-link') as HTMLAnchorElement
    const btnBack    = document.getElementById('btn-back') as HTMLButtonElement
    const btnConfirm = document.getElementById('btn-confirm') as HTMLButtonElement

    labelName.textContent  = i18n.name + ' *'
    labelEmail.textContent = i18n.email + ' *'
    labelPhone.textContent = i18n.phone
    labelNotes.textContent = i18n.notes + ' *'
    nameInput.placeholder  = i18n.namePh
    emailInput.placeholder = i18n.emailPh
    phoneInput.placeholder = i18n.phonePh
    notesInput.placeholder = i18n.notesPh
    privText.textContent   = i18n.privacy + ' '
    privLink.textContent   = i18n.privacyLink
    btnBack.textContent    = i18n.back
    btnConfirm.textContent = i18n.confirm

    document.getElementById('form-error')!.classList.add('hidden')
  }

  // Clear validation error only when the specific offending field is edited
  const _errorEl = document.getElementById('form-error')!
  ;['book-name', 'book-email', 'book-notes'].forEach(id => {
    document.getElementById(id)!.addEventListener('input', e => {
      if (errorField === id && (e.target as HTMLInputElement).value.trim()) {
        _errorEl.classList.add('hidden')
        errorField = null
      }
    })
  })
  ;(document.getElementById('book-privacy') as HTMLInputElement).addEventListener('change', e => {
    if (errorField === 'book-privacy' && (e.target as HTMLInputElement).checked) {
      _errorEl.classList.add('hidden')
      errorField = null
    }
  })

  // Boot
  loadMonth(currentYear, currentMonth)
</script>
