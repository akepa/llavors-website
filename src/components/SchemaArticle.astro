---
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '../i18n/index'
import { getCategoryLabel } from '../utils/blog'
import { getTranslations } from '../i18n/index'
import { business } from '../data/business'

interface Props {
  entry: CollectionEntry<'blog'>
  lang: Lang
  canonicalUrl: string
}

const { entry, lang, canonicalUrl } = Astro.props
const { title, description, publishedAt, updatedAt, category, heroImage, heroImageAlt } = entry.data
const t = getTranslations(lang)

const SITE = business.url
const imageUrl = heroImage
  ? `${SITE}${heroImage.src}`
  : `${SITE}/og-default.png`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  inLanguage: lang,
  articleSection: getCategoryLabel(category, t),
  image: {
    '@type': 'ImageObject',
    url: imageUrl,
    description: heroImageAlt,
  },
  author: {
    '@type': 'Person',
    '@id': business.personId,
    name: business.person.name,
    jobTitle: business.person.jobTitle,
    url: business.url,
  },
  publisher: {
    '@type': 'MedicalBusiness',
    '@id': business.id,
    name: business.name,
    url: business.url,
    logo: {
      '@type': 'ImageObject',
      url: `${business.url}/images/logo.png`,
    },
  },
}
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
