---
interface Props {
  title: string
  description: string
  lang: 'ca' | 'es'
  ogImage?: string
  canonical?: string
  gscVerification?: string
  articleMeta?: {
    publishedAt: string
    updatedAt?: string
    section: string
    author: string
  }
  rssHref?: string
  hreflangs?: { ca: string; es?: string }
}

const {
  title,
  description,
  lang,
  ogImage = '/og-default.png',
  canonical,
  gscVerification,
  articleMeta,
  rssHref,
  hreflangs,
} = Astro.props

const SITE = 'https://www.llavorslogopedia.com'
const BASE = '/llavors-website'

const rawPath = Astro.url.pathname.startsWith(BASE)
  ? Astro.url.pathname.slice(BASE.length) || '/'
  : Astro.url.pathname

const resolvedCanonical = canonical ?? `${SITE}${rawPath}`
const ogImageUrl = `${SITE}${ogImage}`

const caUrl = hreflangs?.ca ?? (lang === 'ca'
  ? resolvedCanonical
  : resolvedCanonical.replace(`${SITE}/es`, SITE))

const esUrl = hreflangs !== undefined
  ? hreflangs.es
  : (lang === 'es' ? resolvedCanonical : `${SITE}/es${rawPath}`)
---
<title>{title} | Llavors Logopèdia</title>
<meta name="description" content={description} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:type" content={articleMeta ? 'article' : 'website'} />
<meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
<meta property="og:locale:alternate" content={lang === 'ca' ? 'es_ES' : 'ca_ES'} />
<meta property="og:url" content={resolvedCanonical} />

{articleMeta && (
  <>
    <meta property="article:published_time" content={articleMeta.publishedAt} />
    {articleMeta.updatedAt && <meta property="article:modified_time" content={articleMeta.updatedAt} />}
    <meta property="article:section" content={articleMeta.section} />
    <meta property="article:author" content={articleMeta.author} />
  </>
)}

<meta name="twitter:card" content="summary_large_image" />

<link rel="canonical" href={resolvedCanonical} />

{hreflangs ? (
  <>
    <link rel="alternate" hreflang="ca-valencia" href={caUrl} />
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    <link rel="alternate" hreflang="x-default" href={caUrl} />
  </>
) : (
  <>
    <link rel="alternate" hreflang="ca" href={caUrl} />
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    <link rel="alternate" hreflang="x-default" href={caUrl} />
  </>
)}

{rssHref && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={lang === 'ca' ? 'Mamà Informada · Llavors Logopèdia' : 'Mamá Informada · Llavors Logopèdia'}
    href={`${SITE}${rssHref}`}
  />
)}

{gscVerification && <meta name="google-site-verification" content={gscVerification} />}
