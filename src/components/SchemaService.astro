---
import type { Lang } from '../i18n/index'
import { business } from '../data/business'

interface Props {
  name: string
  description: string
  url: string
  lang: Lang
  priceFrom?: number
  faqs: { q: string; a: string }[]
}

const { name, description, url, lang, priceFrom, faqs } = Astro.props

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  description,
  serviceType: lang === 'ca' ? 'Logopèdia' : 'Logopedia',
  provider: {
    '@type': 'MedicalBusiness',
    '@id': business.id,
    name: business.name,
    url: business.url,
  },
  areaServed: business.areaServed,
  url,
  inLanguage: lang,
  ...(priceFrom !== undefined && {
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: priceFrom,
        priceCurrency: 'EUR',
      },
    },
  }),
}

// Las mismas preguntas y respuestas que se ven en la página (ServiceLayout).
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
}
---
<script type="application/ld+json" set:html={JSON.stringify(service)} />
<script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
