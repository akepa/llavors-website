---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import Header from '../../../../components/Header.astro'
import Footer from '../../../../components/Footer.astro'
import BlogGrid from '../../../../components/blog/BlogGrid.astro'
import BlogCard from '../../../../components/blog/BlogCard.astro'
import BlogPagination from '../../../../components/blog/BlogPagination.astro'
import BlogCategoryFilter from '../../../../components/blog/BlogCategoryFilter.astro'
import SchemaBreadcrumb from '../../../../components/SchemaBreadcrumb.astro'
import { getTranslations } from '../../../../i18n/index'
import {
  CATEGORIES,
  getCategoryLabel,
  getCategorySlug,
  getCategoryKey,
  formatDate,
  isLang,
} from '../../../../utils/blog'
import { getRelativeLocaleUrl } from 'astro:i18n'

const lang = 'ca' as const
const t = getTranslations(lang)

export const getStaticPaths = (async ({ paginate }) => {
  const allEntries = await getCollection('blog')
  const caEntries = allEntries
    .filter((e) => isLang(e, 'ca') && !e.data.draft)
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())

  return CATEGORIES.flatMap(({ key }) => {
    const slug = getCategorySlug(key, 'ca')
    const filtered = caEntries.filter((e) => e.data.category === key)
    return paginate(filtered, {
      params: { categoria: slug },
      pageSize: 10,
      props: { categoryKey: key },
    })
  })
}) satisfies GetStaticPaths

const { page, categoryKey } = Astro.props
const { categoria } = Astro.params
const categoryLabel = getCategoryLabel(categoryKey, t)
const basePath = getRelativeLocaleUrl('ca', `/blog/categoria/${categoria}/`)

const SITE = 'https://www.llavorslogopedia.com'
const esCatSlug = getCategorySlug(categoryKey, 'es')
const canonicalUrl = page.currentPage === 1
  ? `${SITE}/blog/categoria/${categoria}/`
  : `${SITE}/blog/categoria/${categoria}/${page.currentPage}/`

const hreflangs: { ca: string; es?: string } = {
  ca: canonicalUrl,
  es: page.currentPage === 1
    ? `${SITE}/es/blog/categoria/${esCatSlug}/`
    : `${SITE}/es/blog/categoria/${esCatSlug}/${page.currentPage}/`,
}

const breadcrumbs = [
  { name: 'Inici', url: `${SITE}/` },
  { name: 'Mamà Informada', url: `${SITE}/blog/` },
  { name: categoryLabel, url: `${SITE}/blog/categoria/${categoria}/` },
]
---
<BaseLayout
  lang={lang}
  title={`${categoryLabel} · Mamà Informada`}
  description={`Articles sobre ${categoryLabel.toLowerCase()} per a famílies.`}
  canonical={canonicalUrl}
  hreflangs={hreflangs}
  rssHref="/rss.xml"
>
  <SchemaBreadcrumb slot="head" items={breadcrumbs} />
  <Header t={t} lang={lang} />
  <main>
    <section class="blog-listing">
      <div class="container">
        <div class="blog-listing-intro section-title">
          <span class="section-label">{t.blog_label}</span>
          <h1 set:html={t.blog_h1} />
          <p>{categoryLabel}</p>
        </div>
        <BlogCategoryFilter lang={lang} t={t} activeCategory={categoryKey} />
        <BlogGrid>
          {page.data.map((entry) => (
            <BlogCard
              title={entry.data.title}
              excerpt={entry.data.excerpt}
              categoryLabel={getCategoryLabel(entry.data.category, t)}
              date={formatDate(entry.data.publishedAt, lang)}
              dateISO={entry.data.publishedAt.toISOString().split('T')[0]}
              readingTime={entry.data.readingTime}
              slug={entry.data.slug}
              lang={lang}
              readMoreLabel={t.blog_read_more}
              readingTimeLabel={t.blog_reading_time}
            />
          ))}
        </BlogGrid>
        <BlogPagination
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          basePath={basePath}
        />
      </div>
    </section>
  </main>
  <Footer t={t} lang={lang} />
</BaseLayout>

<style>
  .blog-listing {
    padding: 80px 0 100px;
  }
  .blog-listing-intro h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 10px 0 16px;
  }
  .blog-listing-intro h1 :global(em) { color: var(--pink); font-style: italic; }
</style>
